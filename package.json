{
  "name": "mcp-google-multi",
  "version": "0.0.0-semantically-released",
  "mcpName": "io.github.bakissation/mcp-google-multi",
  "description": "Local MCP server for Google Workspace (Gmail, Drive, Calendar, Sheets, Docs, Contacts, Tasks, Meet, Search Console, +Forms/Chat/Admin) across multiple accounts — OAuth-only, encrypted token storage, deny-by-default writes.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-google-multi": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./identity": "./dist/identity.js",
    "./compose": "./dist/compose.js",
    "./registry": "./dist/registry.js",
    "./oauth-as": "./dist/oauth-as.js",
    "./accounts": "./dist/accounts.js",
    "./token-store": "./dist/token-store.js",
    "./http-transport": "./dist/http-transport.js",
    "./http-config": "./dist/http-config.js",
    "./client": "./dist/client.js",
    "./config-file": "./dist/config-file.js",
    "./fs-atomic": "./dist/fs-atomic.js",
    "./master-key": "./dist/master-key.js",
    "./mcp-token": "./dist/mcp-token.js",
    "./boot-gates": "./dist/boot-gates.js",
    "./tenant-purge": "./dist/tenant-purge.js",
    "./doctor": "./dist/doctor.js",
    "./write-control": "./dist/write-control.js",
    "./scope-catalog": "./dist/scope-catalog.js",
    "./auth": "./dist/auth.js",
    "./usage-metrics": "./dist/usage-metrics.js",
    "./metrics-tap": "./dist/metrics-tap.js",
    "./hint-provider": "./dist/hint-provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakissation/mcp-google-multi.git"
  },
  "bugs": {
    "url": "https://github.com/bakissation/mcp-google-multi/issues"
  },
  "homepage": "https://github.com/bakissation/mcp-google-multi#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google",
    "gmail",
    "google-drive",
    "google-calendar",
    "google-sheets",
    "google-docs",
    "google-contacts",
    "google-workspace",
    "google-tasks",
    "google-meet",
    "search-console",
    "oauth",
    "mcp-server",
    "claude",
    "claude-code"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "watch": "tsc --watch",
    "auth": "node dist/index.js auth --account",
    "migrate-tokens": "node dist/index.js migrate-tokens",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:discovery": "tsx scripts/fetch-discovery.ts",
    "gen:tools": "tsx scripts/gen-tools.ts",
    "gen:coverage": "tsx scripts/gen-coverage.ts",
    "gen:skill": "tsx scripts/gen-skill.ts",
    "eval:contract": "npx --yes promptfoo@0.123.1 eval -c eval/contract/promptfooconfig.yaml --no-progress-bar",
    "measure:lazy": "node scripts/measure-tools.mjs",
    "pack:mcpb": "mcpb pack . mcp-google-multi.mcpb",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=bundle/index.js --external:@napi-rs/keyring --banner:js=\"import{createRequire as __dockerCR}from'node:module';var require=__dockerCR(import.meta.url);\" --log-level=warning"
  },
  "dependencies": {
    "@googleapis/admin": "^37.0.2",
    "@googleapis/analyticsadmin": "^22.0.1",
    "@googleapis/analyticsdata": "^10.1.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/chat": "^51.2.0",
    "@googleapis/docs": "^14.1.0",
    "@googleapis/drive": "^26.0.2",
    "@googleapis/forms": "^11.0.1",
    "@googleapis/gmail": "^22.0.1",
    "@googleapis/meet": "^9.1.0",
    "@googleapis/people": "^12.0.1",
    "@googleapis/searchconsole": "^11.0.1",
    "@googleapis/sheets": "^18.1.1",
    "@googleapis/slides": "^10.1.1",
    "@googleapis/tasks": "^17.0.1",
    "@googleapis/webmasters": "^9.0.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.3.1",
    "googleapis-common": "^9.3.0",
    "jose": "^6.2.8",
    "markdown-it": "15.0.3",
    "mime-types": "^3.0.2",
    "nodemailer": "10.1.4",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "js-yaml": "^4.3.2",
    "semantic-release": "^25.0.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "hono": "^4.13.5",
    "qs": "^6.16.0"
  }
}
