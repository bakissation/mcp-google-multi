{
  "branches": [
    "main",
    { "name": "staging", "prerelease": "beta" },
    { "name": "dev", "prerelease": "alpha" }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/npm",
    [
      "@semantic-release/github",
      {
        "successCommentCondition": "<% return nextRelease.channel == null; %>",
        "failCommentCondition": false,
        "assets": [
          { "path": "mcp-google-multi.mcpb", "label": "MCPB bundle for Claude Desktop (drag-and-drop install)" }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/build-mcpb.sh ${nextRelease.version}",
        "publishCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\"; echo \"channel=${nextRelease.channel || 'latest'}\" >> \"$GITHUB_OUTPUT\""
      }
    ]
  ]
}
