# mcp-google-multi deploy environment. Copy to .env and fill in.
# Never commit .env; secrets enter the container only at runtime.

# Your own Google OAuth client (Web application type). Add
#   <MCP_PUBLIC_URL>/callback
# to its authorized redirect URIs in the Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# alias:email pairs, comma-separated. Example:
#   GOOGLE_ACCOUNTS=work:you@company.com,personal:you@gmail.com
GOOGLE_ACCOUNTS=

# The Google email(s) allowed to authenticate as the owner (comma-separated).
MCP_OWNER_EMAILS=

# The public HTTPS URL Claude connects to.
# - caddy profile: https://<MCP_DOMAIN>
# - tunnel / your own proxy: that public URL
MCP_PUBLIC_URL=

# Encryption key for stored tokens. OPTIONAL: leave unset and the server
# provisions a key file inside the mcp-config volume on first start. If you do
# set it, generate once with `openssl rand -base64 32` and never change it
# while tokens exist (the server refuses to start on a key mismatch rather
# than silently losing your tokens).
# MASTER_KEY=

# ---------------------------------------------------------------------------
# caddy profile only (COMPOSE_PROFILES=caddy docker compose up -d)
# Prerequisites: a domain with an A record to this server, ports 80+443 open.
# ---------------------------------------------------------------------------
# MCP_DOMAIN=mcp.example.com
# Bind on the compose network so Caddy can reach the server (the host port
# stays loopback-published either way):
# MCP_HTTP_HOST=0.0.0.0

# Optional: pin a different image line (dev | beta | an exact version).
# MCP_IMAGE_TAG=6
